<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="60dp"
        android:paddingStart="14dp" android:paddingEnd="8dp" android:background="@color/background"
        app:title="VANZZY HAVEN" app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge"
        app:titleTextColor="@color/ink" />

    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="32dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_hero" android:padding="24dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="TEMPAT BARU, CERITA BARU" android:letterSpacing="0.13" android:textSize="10sp"
                    android:textStyle="bold" android:textColor="#BBE8D7" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="Cari kost yang terasa seperti rumah."
                    android:textColor="@color/white" android:textStyle="bold" android:textSize="27sp"
                    android:lineSpacingExtra="3dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="9dp" android:text="Jelajahi pilihan kamar, lihat fasilitas, dan pesan lebih mudah."
                    android:textColor="#E2F0EB" android:textSize="13sp" android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="22dp" android:hint="Cari nama kost atau kota"
                app:boxBackgroundMode="outline" app:boxBackgroundColor="@color/white"
                app:boxStrokeColor="@color/teal" app:startIconDrawable="@android:drawable/ic_menu_search">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSearch" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:singleLine="true" android:inputType="text" android:imeOptions="actionSearch" />
            </com.google.android.material.textfield.TextInputLayout>

            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:scrollbars="none">
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipCities" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    app:singleSelection="true" app:selectionRequired="true" app:chipSpacingHorizontal="7dp">
                    <com.google.android.material.chip.Chip android:id="@+id/chipAll" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Semua" android:checked="true" />
                    <com.google.android.material.chip.Chip android:id="@+id/chipJakarta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Jakarta" />
                    <com.google.android.material.chip.Chip android:id="@+id/chipBandung" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bandung" />
                    <com.google.android.material.chip.Chip android:id="@+id/chipSurabaya" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Surabaya" />
                    <com.google.android.material.chip.Chip android:id="@+id/chipYogya" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Yogyakarta" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="25dp" android:text="Rekomendasi untukmu" android:textSize="22sp"
                android:textColor="@color/ink" android:textStyle="bold" />
            <TextView android:id="@+id/tvCount" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="Sedang memuat pilihan kost…"
                android:textColor="@color/soft_ink" android:textSize="12sp" />
            <TextView android:id="@+id/tvConnectionHint" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:background="@color/warm" android:padding="13dp" android:textSize="12sp"
                android:textColor="@color/ink" android:visibility="gone" />
            <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal"
                android:indeterminate="true" android:layout_width="match_parent" android:layout_height="3dp"
                android:layout_marginTop="12dp" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvKost" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="16dp"
                android:nestedScrollingEnabled="false" android:clipToPadding="false" />
            <TextView android:id="@+id/tvEmpty" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="30dp" android:gravity="center" android:text="Tidak ada kost sesuai pencarian."
                android:textColor="@color/soft_ink" android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
