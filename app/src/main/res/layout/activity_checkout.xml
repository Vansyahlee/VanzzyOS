<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 xmlns:app="http://schemas.android.com/apk/res-auto"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:background="@color/background" android:orientation="vertical">
 <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent"
   android:layout_height="56dp" android:background="@color/background" app:title="Checkout kamar"
   app:titleTextColor="@color/ink" app:navigationIcon="@android:drawable/ic_menu_revert" />
 <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
   <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content"
     app:cardCornerRadius="21dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/white"
     app:strokeColor="@color/outline" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp">
      <ImageView android:id="@+id/ivRoom" android:layout_width="96dp" android:layout_height="104dp" android:scaleType="centerCrop" android:contentDescription="Foto kamar" />
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="14dp">
       <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PESANAN KAMAR" android:textColor="@color/teal" android:textStyle="bold" android:textSize="10sp" />
       <TextView android:id="@+id/tvKostName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
         android:textStyle="bold" android:textSize="18sp" android:textColor="@color/ink" />
       <TextView android:id="@+id/tvKostAddress" android:layout_width="match_parent" android:layout_height="wrap_content"
         android:layout_marginTop="5dp" android:textColor="@color/soft_ink" android:textSize="11sp" />
      </LinearLayout>
    </LinearLayout>
   </com.google.android.material.card.MaterialCardView>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="27dp"
      android:text="Atur masa tinggal" android:textStyle="bold" android:textSize="20sp" android:textColor="@color/ink" />
   <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginTop="12dp" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/white">
     <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="17dp">
       <TextView android:text="Tanggal masuk" android:textColor="@color/soft_ink" android:textSize="12sp"
          android:layout_width="match_parent" android:layout_height="wrap_content" />
       <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical">
         <TextView android:id="@+id/tvMoveInDate" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
           android:textColor="@color/ink" android:textStyle="bold" android:textSize="17sp" />
         <com.google.android.material.button.MaterialButton android:id="@+id/btnChooseDate" android:layout_width="wrap_content" android:layout_height="wrap_content"
           style="@style/Widget.Material3.Button.OutlinedButton" android:text="Pilih" />
       </LinearLayout>
       <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/outline" android:layout_marginVertical="15dp" />
       <TextView android:text="Durasi sewa" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/soft_ink" android:textSize="12sp" />
       <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center_vertical">
         <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Sewa bulanan" android:textStyle="bold" android:textColor="@color/ink" />
         <com.google.android.material.button.MaterialButton android:id="@+id/btnMinus" android:layout_width="48dp" android:layout_height="48dp" android:text="−" app:cornerRadius="13dp" />
         <TextView android:id="@+id/tvMonths" android:layout_width="78dp" android:layout_height="wrap_content" android:gravity="center"
           android:text="1 bulan" android:textStyle="bold" android:textColor="@color/ink" />
         <com.google.android.material.button.MaterialButton android:id="@+id/btnPlus" android:layout_width="48dp" android:layout_height="48dp" android:text="+" app:cornerRadius="13dp" />
       </LinearLayout>
     </LinearLayout>
   </com.google.android.material.card.MaterialCardView>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp"
      android:text="Data pemesan" android:textStyle="bold" android:textSize="20sp" android:textColor="@color/ink" />
   <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
      android:hint="Nama lengkap" app:boxBackgroundMode="outline" app:boxBackgroundColor="@color/white">
      <com.google.android.material.textfield.TextInputEditText android:id="@+id/etGuestName" android:layout_width="match_parent" android:layout_height="wrap_content"
       android:inputType="textPersonName" android:singleLine="true" android:maxLength="80" />
   </com.google.android.material.textfield.TextInputLayout>
   <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
      android:hint="Nomor WhatsApp / HP" app:boxBackgroundMode="outline" app:boxBackgroundColor="@color/white">
      <com.google.android.material.textfield.TextInputEditText android:id="@+id/etGuestPhone" android:layout_width="match_parent" android:layout_height="wrap_content"
       android:inputType="phone" android:singleLine="true" android:maxLength="18" />
   </com.google.android.material.textfield.TextInputLayout>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp"
      android:text="Metode pembayaran" android:textStyle="bold" android:textColor="@color/ink" android:textSize="20sp" />
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
      android:padding="17dp" android:background="@drawable/bg_chip" android:textColor="@color/teal_dark"
      android:text="✓  Bayar saat check-in\nBelum ada integrasi pembayaran online." android:textSize="13sp" android:lineSpacingExtra="5dp" />
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp"
      android:text="Ringkasan harga" android:textStyle="bold" android:textColor="@color/ink" android:textSize="20sp" />
   <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginTop="12dp" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/white">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="17dp">
       <TextView android:id="@+id/tvQuoteDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/soft_ink" android:textSize="13sp" />
       <TextView android:id="@+id/tvQuoteAmount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="11dp"
        android:text="Menghitung..." android:textColor="@color/teal" android:textStyle="bold" android:textSize="23sp" />
       <TextView android:id="@+id/tvStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textSize="12sp" android:textColor="@color/soft_ink" />
      </LinearLayout>
   </com.google.android.material.card.MaterialCardView>
   <CheckBox android:id="@+id/cbAgreement" android:layout_width="match_parent" android:layout_height="wrap_content"
     android:layout_marginTop="20dp" android:text="Saya memahami bahwa pengajuan ini untuk pengujian dan bukan transaksi sewa resmi."
     android:textColor="@color/ink" android:textSize="12sp" />
 </LinearLayout>
 </androidx.core.widget.NestedScrollView>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
   android:padding="16dp" android:background="@color/white">
   <com.google.android.material.button.MaterialButton android:id="@+id/btnConfirm" android:layout_width="match_parent" android:layout_height="54dp"
     android:text="Ajukan pemesanan  →" android:enabled="false" app:cornerRadius="16dp" />
 </LinearLayout>
</LinearLayout>
